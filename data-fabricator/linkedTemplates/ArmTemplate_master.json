{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nom de fabrique de données",
			"defaultValue": "data-fabricator"
		},
		"AzureFileStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Chaîne sécurisée pour « connectionString » de « AzureFileStorage1 »"
		},
		"AzureFileStorage2_connectionString": {
			"type": "secureString",
			"metadata": "Chaîne sécurisée pour « connectionString » de « AzureFileStorage2 »"
		},
		"AzureFileStorage3_connectionString": {
			"type": "secureString",
			"metadata": "Chaîne sécurisée pour « connectionString » de « AzureFileStorage3 »"
		},
		"AzurePostgreSql1_connectionString": {
			"type": "secureString",
			"metadata": "Chaîne sécurisée pour « connectionString » de « AzurePostgreSql1 »"
		},
		"AnjacDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "anjacbi.database.windows.net"
		},
		"AnjacDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AnjacInfocentre"
		},
		"AnjacDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Mantu"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-fjmihhsvghnkwpb-prod.vault.azure.net/"
		},
		"MantuService_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.mantu.com/afakto/git-v1.0/api/v1.0/accounting/invoices/query"
		},
		"MantuService_properties_typeProperties_clientId": {
			"type": "string",
			"defaultValue": "VCespbhhhd4cQSSVCo0uutgZNkZosRtu"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI pour le compte de stockage contenant des modèles ARM liés"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Jeton SAS pour le compte de stockage contenant des modèles ARM liés"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "data-fabricator_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2018-02-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureFileStorage1_connectionString": {
						"value": "[parameters('AzureFileStorage1_connectionString')]"
					},
					"AzureFileStorage2_connectionString": {
						"value": "[parameters('AzureFileStorage2_connectionString')]"
					},
					"AzureFileStorage3_connectionString": {
						"value": "[parameters('AzureFileStorage3_connectionString')]"
					},
					"AzurePostgreSql1_connectionString": {
						"value": "[parameters('AzurePostgreSql1_connectionString')]"
					},
					"AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"MantuService_properties_typeProperties_url": {
						"value": "[parameters('MantuService_properties_typeProperties_url')]"
					},
					"MantuService_properties_typeProperties_clientId": {
						"value": "[parameters('MantuService_properties_typeProperties_clientId')]"
					},
					"AnjacDB_properties_typeProperties_server": {
						"value": "[parameters('AnjacDB_properties_typeProperties_server')]"
					},
					"AnjacDB_properties_typeProperties_database": {
						"value": "[parameters('AnjacDB_properties_typeProperties_database')]"
					},
					"AnjacDB_properties_typeProperties_userName": {
						"value": "[parameters('AnjacDB_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}